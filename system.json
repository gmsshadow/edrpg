{
  "id": "edrpg",
  "title": "Elite: Dangerous Role Playing Game",
  "description": "A space RPG set in the Elite: Dangerous universe.",
  "version": "0.1.7",
  "authors": [
    {
      "name": "gmsshadow",
      "url": "https://github.com/gmsshadow"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "module/edrpg.mjs"
  ],
  "styles": [
    "styles/edrpg.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "biography"
        ]
      },
      "npcIndividual": {
        "htmlFields": [
          "biography"
        ]
      },
      "opponent": {
        "htmlFields": [
          "notes"
        ]
      }
    },
    "Item": {
      "background": {
        "htmlFields": [
          "description"
        ]
      },
      "enhancement": {
        "htmlFields": [
          "description"
        ]
      },
      "karma": {
        "htmlFields": [
          "description"
        ]
      },
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "armour": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "packs": [
    {
      "name": "karma-capabilities",
      "label": "Karma Capabilities",
      "path": "packs/karma-capabilities",
      "type": "Item",
      "system": "edrpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "weapons",
      "label": "Weapons",
      "path": "packs/weapons",
      "type": "Item",
      "system": "edrpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "armour",
      "label": "Armour",
      "path": "packs/armour",
      "type": "Item",
      "system": "edrpg",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "Elite: Dangerous RPG",
      "sorting": "a",
      "color": "#0b2238",
      "packs": [
        "karma-capabilities",
        "weapons",
        "armour"
      ]
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
  "grid": {
    "distance": 2,
    "units": "m"
  },
  "primaryTokenAttribute": "endurance",
  "secondaryTokenAttribute": "karma.standard",
  "socket": true,
  "url": "https://github.com/gmsshadow/edrpg",
  "readme": "https://github.com/gmsshadow/edrpg/blob/main/README.md",
  "bugs": "https://github.com/gmsshadow/edrpg/issues",
  "manifest": "https://raw.githubusercontent.com/gmsshadow/edrpg/refs/heads/main/system.json",
  "download": "https://github.com/gmsshadow/edrpg/archive/refs/heads/main.zip",
  "license": "LICENSE"
}
