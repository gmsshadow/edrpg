<div class="tab datasheet {{tab.cssClass}}" data-group="primary" data-tab="datasheet">
   {{#if isPartner}}
   <div class="ed-partner-strip">
      <i class="fa-solid fa-user-group"></i>
      {{#if partnerInfo.host}}{{localize "EDRPG.partner.of"}} <a data-action="openActor" data-uuid="{{partnerInfo.host.uuid}}">{{partnerInfo.host.name}}</a>{{else}}<span class="warn">{{localize "EDRPG.partner.noHostShort"}}</span>{{/if}}
      <span class="muted">{{#if (eq partnerInfo.depth 2)}}{{localize "EDRPG.partner.depth2"}}{{else}}{{localize "EDRPG.partner.depth1"}}{{/if}}</span>
      {{#if partnerInfo.cyber}}<span class="{{#if partnerInfo.cyber.over}}warn{{else}}muted{{/if}}">{{localize "EDRPG.partner.virtualKarma" cost=partnerInfo.cyber.cost total=partnerInfo.cyber.virtual}}</span>{{/if}}
   </div>
   {{/if}}
   {{#if creation}}{{> edrpgCreation}}{{/if}}
   {{#if rankUp}}
   <div class="ed-rankup-banner">
      <i class="fa-solid fa-ranking-star"></i>
      <span>{{localize "EDRPG.rankUp.banner" rank=rankUp.next cap=rankUp.cap}}{{#if (gt rankUp.count 1)}} {{localize "EDRPG.rankUp.more" count=rankUp.count}}{{/if}}</span>
      {{#if editable}}<button type="button" class="ed-button" data-action="rankUp"><i class="fa-solid fa-arrow-up"></i> {{localize "EDRPG.rankUp.button"}}</button>{{/if}}
   </div>
   {{/if}}

   {{#> edrpgSection title="EDRPG.sheet.Backgrounds" icon="fa-solid fa-book-open" count=backgroundCount addType="background"}}
   <div class="ed-backgrounds">
      {{#each backgroundCards as |card|}}
      <div class="ed-card {{#if card.empty}}empty{{/if}} {{#if card.fixed}}fixed{{/if}}" {{#if card.id}}data-item-id="{{card.id}}"{{/if}}>
         {{#if card.empty}}
            {{#if @root.editable}}<a class="ed-card-add" data-action="createItem" data-type="background"><i class="fa-solid fa-plus"></i></a>{{/if}}
         {{else}}
            <div class="ed-card-name">
               {{#if card.id}}<a data-action="editItem">{{card.name}}</a>{{else}}{{localize card.name}}{{/if}}
               {{#if card.choices}}<span class="ed-choices" data-tooltip="EDRPG.item.choices">×{{card.choices}}</span>{{/if}}
            </div>
            <ul class="ed-card-mods">
               {{#each card.mods as |mod|}}<li>{{localize mod.label}} <b>+{{mod.bonus}}</b></li>{{/each}}
            </ul>
            {{#if card.partner}}
            <button type="button" class="ed-card-action" data-action="createPartner">
               <i class="fa-solid fa-user-group"></i> {{#if card.partner.exists}}{{localize "EDRPG.partner.open"}}{{else}}{{localize "EDRPG.partner.create"}}{{/if}}
            </button>
            {{/if}}
            {{#if card.id}}{{#if @root.editable}}
            <a class="ed-card-delete" data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-xmark"></i></a>
            {{/if}}{{/if}}
         {{/if}}
      </div>
      {{/each}}
   </div>
   {{/edrpgSection}}

   {{#if editable}}
   <div class="ed-skill-toolbar">
      <button type="button" class="ed-button" data-action="endAdventure" data-tooltip="EDRPG.endAdventure.buttonHint">
         <i class="fa-solid fa-flag-checkered"></i> {{localize "EDRPG.endAdventure.button"}}
         <span class="ed-button-count">{{localize "EDRPG.endAdventure.ticked" count=tickedCount}}</span>
      </button>
   </div>
   {{/if}}

   <div class="ed-skill-grid">
      {{#each skillCategories as |cat|}}
      {{#> edrpgSection title=cat.label icon=cat.icon chip=cat.chip chipAction=cat.chipAction chipTooltip=cat.chipTooltip}}
      <table class="ed-skill-table">
         <thead>
            <tr>
               <th class="name">{{localize "EDRPG.sheet.table.skills.skill"}}</th>
               <th>{{localize "EDRPG.sheet.table.skills.score"}}</th>
               <th>{{localize "EDRPG.sheet.table.skills.bonus"}}</th>
               <th class="check"><i class="fa-solid fa-check"></i></th>
            </tr>
         </thead>
         <tbody>
            {{#each cat.skills as |skill|}}
            <tr data-skill="{{skill.key}}" data-category="{{skill.category}}">
               <th class="name"><a data-action="rollSkill" data-tooltip="{{localize skill.description}}">{{localize skill.label}}</a></th>
               <td class="score {{#if skill.overCap}}over-cap{{/if}} {{#if skill.modified}}modified{{/if}}">
                  <a data-action="configureSkill" data-tooltip="EDRPG.skillConfig.open">{{skill.score}}</a>
               </td>
               <td class="bonus">{{skill.bonus}}{{#if skill.rollBonus}}<sup class="ed-roll-bonus" data-tooltip="EDRPG.socialFactor.title">{{skill.rollBonus}}</sup>{{/if}}</td>
               <td class="check">
                  <a data-action="toggleSkillUsed" data-tooltip="EDRPG.sheet.skillUsedHint">
                     {{#if skill.used}}<i class="fa-solid fa-check"></i>{{/if}}
                  </a>
               </td>
            </tr>
            {{/each}}
         </tbody>
      </table>
      {{/edrpgSection}}
      {{/each}}

      {{#> edrpgSection title="EDRPG.sheet.Enhancements" icon="fa-solid fa-person-running" addType="enhancement"}}
      <div class="ed-subheader">{{localize "EDRPG.sheet.descriptionEffect"}}</div>
      <ol class="ed-enhancements">
         {{#each enhancements as |item|}}
         <li data-item-id="{{item.id}}" class="draggable">
            <a class="ed-item-name" data-action="editItem">{{item.name}}</a>
            <span class="ed-item-text">{{item.summary}}</span>
            {{#if @root.editable}}<a class="ed-row-delete" data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-xmark"></i></a>{{/if}}
         </li>
         {{/each}}
      </ol>
      {{/edrpgSection}}
   </div>
</div>
