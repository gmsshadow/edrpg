<div class="item-list-block">
   <h2 class="section-title {{style}}">
      <span>{{localize title}}</span>
      {{#if count}}<span class="count">{{count}}</span>{{/if}}
      {{#if @root.editable}}
      <a class="item-control" data-action="createItem" data-type="{{type}}" data-tooltip="EDRPG.sheet.addItem">
         <i class="fa-solid fa-plus"></i>
      </a>
      {{/if}}
   </h2>
   <ol class="item-list">
      {{#each items as |item|}}
      <li class="item draggable" data-item-id="{{item.id}}" data-document-uuid="{{item.uuid}}">
         <img src="{{item.img}}" alt="" class="item-img">
         <a class="item-name" data-action="editItem">{{item.name}}</a>
         <span class="item-meta">
            {{#if (eq item.type "background")}}
            {{#each item.system.validSkills as |mod|}}<span class="tag">{{localize (lookup @root.skillLabels mod.skill)}} +{{mod.bonus}}</span>{{/each}}
            {{/if}}
            {{#if (eq item.type "karma")}}<span class="tag">{{localize "EDRPG.equipment.KarmaCost"}} {{item.system.cost}}</span>{{/if}}
            {{#if item.system.free}}<span class="tag free">{{localize "EDRPG.item.free"}}</span>{{/if}}
         </span>
         <span class="item-controls">
            <a class="item-control" data-action="editItem" data-tooltip="EDRPG.sheet.editItem"><i class="fa-solid fa-pen"></i></a>
            {{#if @root.editable}}
            <a class="item-control" data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
         </span>
      </li>
      {{else}}
      <li class="empty">{{localize "EDRPG.sheet.noItems"}}</li>
      {{/each}}
   </ol>
</div>
