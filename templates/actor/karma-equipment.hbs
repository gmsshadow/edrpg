<div class="tab karma-equipment {{tab.cssClass}}" data-group="primary" data-tab="karmaEquipment">

   {{#> edrpgSection title="EDRPG.sheet.KarmaCapabilities" icon="fa-solid fa-yin-yang" style="karma" count=karmaCount addType="karma" chip=restChip chipAction="restKarma" chipTooltip="EDRPG.karma.restHint"}}
   <table class="ed-table karma">
      <thead>
         <tr>
            <th class="name">{{localize "EDRPG.sheet.capability"}}</th>
            <th>{{localize "EDRPG.item.cost"}}</th>
            <th>{{localize "EDRPG.item.category"}}</th>
            <th class="notes">{{localize "EDRPG.karma.effect"}}</th>
            <th class="use"></th>
            <th class="controls"></th>
         </tr>
      </thead>
      <tbody>
         {{#each karmaGroups as |group|}}
         <tr class="group"><td colspan="6">{{localize group.label}}</td></tr>
         {{#each group.items as |item|}}
         <tr {{#if item.id}}data-item-id="{{item.id}}" class="draggable"{{else}}class="fixed" data-builtin="escapeDeath"{{/if}}>
            <th class="name">{{#if item.id}}<a data-action="editItem">{{item.name}}</a>{{else}}{{item.name}}{{/if}}</th>
            <td>{{item.costLabel}}</td>
            <td>{{localize item.categoryLabel}}</td>
            <td class="notes">{{item.summary}}</td>
            <td class="use">
               {{#if @root.owner}}
               <button type="button" class="ed-use {{#if item.used}}used{{/if}}" data-action="useKarma"
                       {{#unless item.usable}}disabled{{/unless}} data-tooltip="{{item.useTooltip}}">
                  {{#if item.used}}{{localize "EDRPG.karma.used"}}{{else}}{{localize "EDRPG.karma.use"}}{{/if}}
               </button>
               {{/if}}
            </td>
            <td class="controls">{{#if item.id}}{{#if @root.editable}}<a data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-xmark"></i></a>{{/if}}{{/if}}</td>
         </tr>
         {{/each}}
         {{/each}}
      </tbody>
   </table>
   {{/edrpgSection}}

   <div class="ed-two-col">
      {{#> edrpgSection title="EDRPG.sheet.carriedWeapons" icon="fa-solid fa-gun" addType="weapon"}}
      <table class="ed-table gear">
         <thead><tr><th class="name">{{localize "EDRPG.equipment.Weapon"}}</th><th>{{localize "EDRPG.sheet.ammo"}}</th><th class="toggle">{{localize "EDRPG.equipment.Equipped"}}</th><th class="controls"></th></tr></thead>
         <tbody>
            {{#each carriedWeapons as |w|}}
            <tr data-item-id="{{w.id}}" class="draggable">
               <th class="name"><a data-action="editItem">{{w.name}}</a></th>
               <td class="ammo">{{#if w.usesAmmo}}<input type="number" data-item-field="system.ammo.value" value="{{w.ammo.value}}" min="0" step="1">/{{w.ammo.max}}{{else}}—{{/if}}</td>
               <td class="toggle"><a data-action="toggleItem" data-field="system.equipped" data-tooltip="EDRPG.weapon.equippedHint">{{#if w.equipped}}<i class="fa-solid fa-hand-fist"></i>{{else}}<i class="fa-regular fa-circle"></i>{{/if}}</a></td>
               <td class="controls">{{#if @root.editable}}<a data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-xmark"></i></a>{{/if}}</td>
            </tr>
            {{else}}<tr class="empty"><td colspan="4">{{localize "EDRPG.weapon.noneCarried"}}</td></tr>{{/each}}
         </tbody>
      </table>
      {{/edrpgSection}}
      {{#> edrpgSection title="EDRPG.sheet.clothing" icon="fa-solid fa-shirt" addType="clothing"}}
      <table class="ed-table gear">
         <thead><tr><th class="name">{{localize "EDRPG.equipment.Item"}}</th><th class="notes">{{localize "EDRPG.sheet.notes"}}</th><th class="toggle">{{localize "EDRPG.equipment.Worn"}}</th><th class="controls"></th></tr></thead>
         <tbody>
            {{#each clothing as |a|}}
            <tr data-item-id="{{a.id}}" class="draggable">
               <th class="name"><a data-action="editItem">{{a.name}}</a></th>
               <td class="notes">{{a.notes}}</td>
               <td class="toggle"><a data-action="toggleItem" data-field="system.worn">{{#if a.worn}}<i class="fa-solid fa-shirt"></i>{{else}}<i class="fa-regular fa-circle"></i>{{/if}}</a></td>
               <td class="controls">{{#if @root.editable}}<a data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-xmark"></i></a>{{/if}}</td>
            </tr>
            {{else}}<tr class="empty"><td colspan="4">{{localize "EDRPG.armour.noneCarried"}}</td></tr>{{/each}}
         </tbody>
      </table>
      <p class="hint">{{localize "EDRPG.sheet.clothingHint"}}</p>
      {{/edrpgSection}}
   </div>

   <div class="ed-two-col">
      {{#> edrpgSection title="EDRPG.sheet.gear" icon="fa-solid fa-toolbox" addType="gear"}}
      <table class="ed-table gear">
         <thead><tr><th class="name">{{localize "EDRPG.equipment.Item"}}</th><th class="qty">{{localize "EDRPG.gear.qtyShort"}}</th><th class="notes">{{localize "EDRPG.sheet.notes"}}</th><th class="toggle">{{localize "EDRPG.gear.inUse"}}</th><th class="controls"></th></tr></thead>
         <tbody>
            {{#each gear as |g|}}
            <tr data-item-id="{{g.id}}" class="draggable">
               <th class="name"><a data-action="editItem">{{g.name}}</a></th>
               <td class="qty">{{#if g.uses}}<input type="number" data-item-field="system.uses.value" value="{{g.uses.value}}" min="0" step="1" data-tooltip="EDRPG.gear.uses">/{{g.uses.max}}{{else}}<input type="number" data-item-field="system.quantity" value="{{g.quantity}}" min="0" step="1">{{/if}}</td>
               <td class="notes">{{g.notes}}</td>
               <td class="toggle">{{#if g.toggleable}}<a data-action="toggleItem" data-field="system.active" data-tooltip="EDRPG.gear.activeHint">{{#if g.active}}<i class="fa-solid fa-toggle-on"></i>{{else}}<i class="fa-solid fa-toggle-off"></i>{{/if}}</a>{{/if}}</td>
               <td class="controls">{{#if @root.editable}}<a data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-xmark"></i></a>{{/if}}</td>
            </tr>
            {{else}}<tr class="empty"><td colspan="5">{{localize "EDRPG.gear.none"}}</td></tr>{{/each}}
         </tbody>
      </table>
      {{/edrpgSection}}
      {{#> edrpgSection title="EDRPG.sheet.cybernetics" icon="fa-solid fa-microchip" addType="cybernetic"}}
      <table class="ed-table gear">
         <thead><tr><th class="name">{{localize "EDRPG.equipment.Item"}}</th><th class="qty" data-tooltip="EDRPG.cybernetic.karmaCost">{{localize "EDRPG.cybernetic.karmaShort"}}</th><th class="notes">{{localize "EDRPG.cybernetic.effects"}}</th><th class="controls"></th></tr></thead>
         <tbody>
            {{#each cybernetics as |c|}}
            <tr data-item-id="{{c.id}}" class="draggable">
               <th class="name"><a data-action="editItem">{{c.name}}</a>{{#if c.discreet}} <i class="fa-solid fa-eye-slash" data-tooltip="EDRPG.armour.discreet"></i>{{/if}}</th>
               <td class="qty">{{c.karmaCost}}</td>
               <td class="notes">{{c.notes}}</td>
               <td class="controls">{{#if @root.editable}}<a data-action="deleteItem" data-tooltip="EDRPG.sheet.deleteItem"><i class="fa-solid fa-xmark"></i></a>{{/if}}</td>
            </tr>
            {{else}}<tr class="empty"><td colspan="4">{{localize "EDRPG.cybernetic.none"}}</td></tr>{{/each}}
         </tbody>
      </table>
      {{#if cybernetics.length}}<p class="hint">{{localize "EDRPG.cybernetic.karmaSummary" spent=cyberKarma.spent fromCyber=cyberKarma.fromCyber}}{{#if cyberKarma.cyborg}} {{localize "EDRPG.cybernetic.cyborgNote"}}{{/if}}</p>{{/if}}
      {{/edrpgSection}}
   </div>

   <div class="ed-equipment-grid">
      <div class="ed-stack">
         {{#> edrpgSection title="EDRPG.sheet.pack" icon="fa-solid fa-suitcase"}}
         {{> edrpgStoredList items=packItems}}
         {{/edrpgSection}}
         {{#> edrpgSection title="EDRPG.sheet.shipStorage" icon="fa-solid fa-shuttle-space"}}
         {{> edrpgStoredList items=shipItems}}
         {{/edrpgSection}}
      </div>
      {{#> edrpgSection title="EDRPG.sheet.cash" icon="fa-solid fa-coins" style="cash"}}
      <div class="ed-cash">
         <label><span class="ed-cash-tag">{{localize "EDRPG.sheet.credits"}}</span>
            <input type="number" name="system.cash.cr" value="{{source.cash.cr}}" min="0" step="1"></label>
         <label><span class="ed-cash-tag">{{localize "EDRPG.sheet.microCredits"}}</span>
            <input type="number" name="system.cash.mcr" value="{{source.cash.mcr}}" min="0" step="1"></label>
         <label><span class="ed-cash-tag">{{localize "EDRPG.sheet.units"}}</span>
            <input type="number" name="system.cash.u" value="{{source.cash.u}}" min="0" step="1"></label>
         <p class="hint">{{localize "EDRPG.sheet.cashHint"}}</p>
      </div>
      {{/edrpgSection}}
   </div>
</div>
