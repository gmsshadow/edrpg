<section class="tab main {{tab.cssClass}}" data-group="primary" data-tab="main">
   <h2 class="section-title">{{localize "EDRPG.sheet.biography"}}</h2>
   {{formInput biographyField value=source.biography enriched=enrichedBiography toggled=true name="system.biography"}}

   <h2 class="section-title">{{localize "EDRPG.sheet.adjustments"}}</h2>
   <div class="adjustments">
      <label>
         <span>{{localize "EDRPG.sheet.karmaBonus"}}</span>
         <input type="number" name="system.karma.standard.bonus" value="{{source.karma.standard.bonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label>
         <span>{{localize "EDRPG.sheet.enduranceBonus"}}</span>
         <input type="number" name="system.endurance.bonus" value="{{source.endurance.bonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
      </label>
      <p class="hint">{{localize "EDRPG.sheet.adjustmentsHint"}}</p>
   </div>
</section>
