<section class="resource-config">
   <h3 class="config-heading karma">{{localize "EDRPG.sheet.karma.standard"}}</h3>
   <table class="breakdown">
      <tbody>
         <tr><td>{{localize "EDRPG.resourceConfig.fromRank"}}</td><td class="num">{{system.karma.standard.base}}</td></tr>
         {{#if system.karma.standard.cybernetics}}<tr><td>{{localize "EDRPG.resourceConfig.cybernetics"}}</td><td class="num">−{{system.karma.standard.cybernetics}}</td></tr>{{/if}}
      </tbody>
   </table>
   <div class="form-group">
      <label>{{localize "EDRPG.sheet.karmaBonus"}}</label>
      <div class="form-fields">
         <input type="number" name="system.karma.standard.bonus" value="{{systemSource.karma.standard.bonus}}" step="1">
      </div>
   </div>
   <table class="breakdown"><tbody>
      <tr class="total"><td>{{localize "EDRPG.resourceConfig.maximum"}}</td><td class="num">{{system.karma.standard.max}}</td></tr>
   </tbody></table>

   {{#unless system.depth}}
   <div class="form-group">
      <label>{{localize "EDRPG.partner.allowKarma"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.partnerKarma" {{checked systemSource.partnerKarma}}></div>
      <p class="hint">{{localize "EDRPG.partner.allowKarmaHint"}}</p>
   </div>
   {{/unless}}

   <h3 class="config-heading karma">{{localize "EDRPG.sheet.karma.cyber"}}</h3>
   {{#if system.karma.cyber.enhancement}}
   <table class="breakdown"><tbody>
      <tr><td>{{localize "EDRPG.enhancement.effect.cyberneticAffinity"}}</td><td class="num">{{system.karma.cyber.enhancement}}</td></tr>
      {{#if system.karma.cyber.spent}}<tr><td>{{localize "EDRPG.resourceConfig.cybernetics"}}</td><td class="num">−{{system.karma.cyber.spent}}</td></tr>{{/if}}
   </tbody></table>
   {{/if}}
   <div class="form-group">
      <label>{{#if system.karma.cyber.enhancement}}{{localize "EDRPG.resourceConfig.other"}}{{else}}{{localize "EDRPG.resourceConfig.maximum"}}{{/if}}</label>
      <div class="form-fields">
         <input type="number" name="system.karma.cyber.bonus" value="{{systemSource.karma.cyber.bonus}}" min="0" step="1">
      </div>
      <p class="hint">{{localize "EDRPG.sheet.cyberKarmaHint"}}</p>
   </div>

   <h3 class="config-heading endurance">{{localize "EDRPG.sheet.endurance"}}</h3>
   <table class="breakdown">
      <tbody>
         <tr><td>{{localize "EDRPG.resourceConfig.fromRank"}}</td><td class="num">{{system.endurance.rank}}</td></tr>
         {{#if system.endurance.cybernetics}}<tr><td>{{localize "EDRPG.resourceConfig.cybernetics"}}</td><td class="num">+{{system.endurance.cybernetics}}</td></tr>{{/if}}
         {{#if system.endurance.enhancement}}<tr><td>{{localize "EDRPG.enhancement.effect.tough"}}</td><td class="num">+{{system.endurance.enhancement}}</td></tr>{{/if}}
      </tbody>
   </table>
   <div class="form-group">
      <label>{{localize "EDRPG.sheet.enduranceBonus"}}</label>
      <div class="form-fields">
         <input type="number" name="system.endurance.bonus" value="{{systemSource.endurance.bonus}}" step="1">
      </div>
   </div>
   <table class="breakdown"><tbody>
      <tr class="total"><td>{{localize "EDRPG.resourceConfig.maximum"}}</td><td class="num">{{system.endurance.max}}</td></tr>
   </tbody></table>
   <p class="hint">{{localize "EDRPG.sheet.adjustmentsHint"}}</p>
</section>
