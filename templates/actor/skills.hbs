<section class="tab skills {{tab.cssClass}}" data-group="primary" data-tab="skills">
   <div class="skill-grid">
      {{#each skillCategories as |cat|}}
      <div class="skill-category">
         <h2 class="section-title">{{localize cat.label}}</h2>
         <table class="skill-table">
            <thead>
               <tr>
                  <th class="skill-name">{{localize "EDRPG.sheet.table.skills.skill"}}</th>
                  <th>{{localize "EDRPG.sheet.table.skills.base"}}</th>
                  <th>{{localize "EDRPG.sheet.table.skills.learning"}}</th>
                  <th>{{localize "EDRPG.sheet.table.skills.score"}}</th>
                  <th>{{localize "EDRPG.sheet.table.skills.bonus"}}</th>
                  <th class="check">&check;</th>
               </tr>
            </thead>
            <tbody>
               {{#each cat.skills as |skill|}}
               <tr data-skill="{{skill.key}}" data-category="{{skill.category}}" class="{{#if skill.overCap}}over-cap{{/if}}">
                  <th class="skill-name">
                     <a data-action="rollSkill" data-tooltip="{{localize skill.description}}">{{localize skill.label}}</a>
                  </th>
                  <td><span class="derived">{{skill.base}}</span></td>
                  <td>
                     <input type="number" name="{{skill.path}}.learning" value="{{skill.learning}}" min="0" step="1"
                            {{#unless @root.editable}}disabled{{/unless}}>
                  </td>
                  <td>
                     <span class="derived" {{#if skill.overCap}}data-tooltip="{{localize 'EDRPG.sheet.overCap' cap=skill.cap}}"{{/if}}>{{skill.score}}</span>
                  </td>
                  <td><span class="derived bonus">{{skill.bonus}}</span></td>
                  <td class="check">
                     <a data-action="toggleSkillUsed" data-tooltip="EDRPG.sheet.skillUsedHint">
                        <i class="fa-regular {{#if skill.used}}fa-square-check{{else}}fa-square{{/if}}"></i>
                     </a>
                  </td>
               </tr>
               {{/each}}
            </tbody>
         </table>
      </div>
      {{/each}}
   </div>
</section>
