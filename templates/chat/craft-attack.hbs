<div class="edrpg edrpg-chat edrpg-attack edrpg-craft-attack {{#if hit}}hit{{else}}miss{{/if}}">
   <div class="attack-head">
      <span class="attack-who">{{vehicleName}}</span>
      {{#if targetName}}<i class="fa-solid fa-angles-right"></i> <span class="attack-who">{{targetName}}</span>{{/if}}
   </div>
   <div class="attack-weapon">{{weaponName}}{{#if (gt count 1)}} <span class="ed-chip" title="{{localize "EDRPG.rules.groupFire.name"}}">×{{count}}</span>{{/if}}{{#if action}} <span class="ed-chip">{{localize action}}</span>{{/if}}</div>
   <div class="attack-columns">
      <dl class="breakdown">
         <dt class="head">{{localize "EDRPG.attack.toHit"}}</dt><dd class="head">{{total}}</dd>
         <dt>{{localize "EDRPG.contest.d10"}}</dt><dd>{{natural}}</dd>
         {{#each parts as |p|}}<dt>{{localize p.label}}{{#if p.note}} <span class="muted">{{p.note}}</span>{{/if}}</dt><dd>{{p.signed}}</dd>{{/each}}
      </dl>
      <dl class="breakdown">
         <dt class="head">{{localize "EDRPG.vehicle.defence"}}</dt><dd class="head">{{defence}}</dd>
         {{#if damage}}
         <dt>{{localize "EDRPG.sheet.damage"}}</dt><dd><b>{{damage.total}}</b></dd>
         {{#if scale}}<dt class="muted">{{localize "EDRPG.combined.scaled" scale=(localize scale.label)}}</dt><dd class="muted">{{damage.unscaled}} {{scale.factor}}</dd>{{/if}}
         {{#if damage.burst}}<dt class="muted">{{localize "EDRPG.damage.burst"}}</dt><dd class="muted">+{{damage.burst}}</dd>{{/if}}
         {{#if (ne damage.vsShields null)}}<dt class="muted">{{localize "EDRPG.craft.damageVsShields"}}</dt><dd class="muted">{{damage.vsShields}}</dd>{{/if}}
         {{#if damage.bonusVsShields}}<dt class="muted">{{localize "EDRPG.craft.bonusVsShieldsLabel"}}</dt><dd class="muted">+{{damage.bonusVsShields}}</dd>{{/if}}
         {{#if damage.bonusVsHull}}<dt class="muted">{{localize "EDRPG.craft.bonusVsHullLabel"}}</dt><dd class="muted">+{{damage.bonusVsHull}}</dd>{{/if}}
         {{/if}}
      </dl>
   </div>
   <div class="outcome {{#if hit}}success{{else}}failure{{/if}}">
      {{#if hit}}{{localize "EDRPG.attack.hit"}}{{#if margin}} — {{localize "EDRPG.attack.beatBy" points=margin}}{{/if}}{{else}}{{localize "EDRPG.attack.miss"}}{{/if}}
   </div>
   {{#if coverBlown}}<div class="attack-note"><i class="fa-solid fa-house-crack"></i> {{localize "EDRPG.combined.coverBlown" name=targetName}}</div>{{/if}}
   {{#if damage.noBonuses}}<div class="attack-note muted">{{localize "EDRPG.combined.noBonuses"}}</div>{{/if}}
   {{#each defenceNotes as |n|}}<div class="attack-note muted">{{localize n}}</div>{{/each}}
   {{#if aim}}<div class="attack-note">{{localize "EDRPG.crit.aimed" name=aim.name}}</div>{{/if}}
   {{#if pointDefence}}<div class="attack-note">{{#if pointDefence.destroyed}}{{localize "EDRPG.equip.pdHit" roll=pointDefence.roll}}{{else}}{{localize "EDRPG.equip.pdMiss" roll=pointDefence.roll}}{{/if}}</div>{{/if}}
   {{#if sniping}}<div class="attack-note">{{localize "EDRPG.vcombat.snipingTarget"}}</div>{{/if}}
   {{#if reason}}<div class="attack-note">{{localize (concat "EDRPG.contest.reason." reason)}}</div>{{/if}}
   {{#if (and critical hit)}}{{#unless aim}}<div class="attack-note">{{#if shipTarget}}{{localize "EDRPG.crit.naturalTen"}}{{else}}{{localize "EDRPG.vehicle.naturalTen"}}{{/if}}</div>{{/unless}}{{/if}}
   {{#if ammo}}<div class="attack-note muted">{{localize "EDRPG.attack.ammoLeft" left=ammo.left max=ammo.max}}</div>{{/if}}
   {{#if applied.length}}
   <ul class="damage-applied">
      {{#each applied as |a|}}
      <li><strong>{{a.name}}</strong>:
         {{#if a.individual}}{{localize "EDRPG.damage.took" taken=a.taken}} <span class="muted">({{a.amount}}{{#if a.armour}} − {{a.absorbed}} {{a.armour.name}}{{/if}})</span> {{localize "EDRPG.damage.enduranceFromTo" before=a.before after=a.after max=a.max}}{{#if a.knocked}} <span class="ed-chip">{{localize "EDRPG.status.knockedOver"}}</span>{{/if}}{{#each a.conditionLabels as |c|}} <span class="ed-chip">{{localize c}}</span>{{/each}}{{/if}}
         {{#if a.toShields}}{{localize "EDRPG.vehicle.shieldsHit" before=a.shieldsBefore after=a.shieldsAfter}}{{#if a.collapsed}} <span class="ed-chip">{{localize "EDRPG.vehicle.shieldsCollapse"}}</span>{{/if}}{{/if}}
         {{#if a.toHull}} {{localize "EDRPG.vehicle.hullHit" damage=a.toHull before=a.hullBefore after=a.hullAfter}}{{/if}}
         {{#if a.destroyed}} <span class="ed-chip">{{localize "EDRPG.vehicle.destroyed"}}</span>{{/if}}
         {{#if a.destabilised}}<div class="ed-crit">{{localize "EDRPG.destab.collapse"}}</div>{{/if}}
         {{#if a.impervious}}<div class="ed-crit">{{localize "EDRPG.aegis.impervious"}}</div>{{/if}}
         {{#if a.swarmed}}<div class="muted">{{localize "EDRPG.aegis.swarm"}}</div>{{/if}}
         {{#if a.flashpoint}}<div class="ed-crit">{{localize "EDRPG.engineering.flashpointFired" names=a.flashpoint}}</div>{{/if}}
         {{#if a.crit.hangar.length}}<div class="ed-crit">{{#each a.crit.hangar as |n|}}{{{n}}}<br>{{/each}}</div>{{/if}}
         {{#if a.disabled}}<div class="ed-crit">{{localize "EDRPG.destab.disabled"}}</div>{{/if}}
         {{#if a.components.length}}<ul class="ed-destab">{{#each a.components as |c|}}<li>{{localize "EDRPG.crit.componentHit" name=c.name damage=c.damage before=c.before after=c.after}}{{#if c.destroyed}} <span class="ed-chip">{{localize "EDRPG.crit.destroyed"}}</span> {{c.effect}}{{/if}}</li>{{/each}}</ul>{{/if}}
         {{#if a.component}}{{localize "EDRPG.crit.componentHit" name=a.component.name damage=a.component.damage before=a.component.before after=a.component.after}}{{#if a.component.destroyed}} <span class="ed-chip">{{localize "EDRPG.crit.destroyed"}}</span> {{a.component.effect}}{{/if}}{{/if}}
         {{#if a.crit}}<div class="ed-crit">{{#if a.crit.nothing}}{{localize "EDRPG.crit.nothing" roll=a.crit.table kind=a.crit.kindLabel}}{{else}}{{localize "EDRPG.crit.result" roll=a.crit.table kind=a.crit.kindLabel name=a.crit.name before=a.crit.before after=a.crit.after}}{{#if a.crit.position}} <span class="muted">({{localize "EDRPG.crit.position" roll=a.crit.position}})</span>{{/if}}{{#if a.crit.destroyed}} <span class="ed-chip">{{localize "EDRPG.crit.destroyed"}}</span> {{a.crit.effect}}{{/if}}{{/if}}</div>{{/if}}
      </li>
      {{/each}}
   </ul>
   {{/if}}
   <div class="attack-controls"></div>
</div>
