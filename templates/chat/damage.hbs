<div class="edrpg edrpg-chat edrpg-damage">
   <div class="attack-head">
      <span class="attack-who">{{actorName}}</span>
      {{#if targetName}}<i class="fa-solid fa-angles-right"></i> <span class="attack-who">{{targetName}}</span>{{/if}}
   </div>
   <div class="attack-weapon">{{weaponName}} <span class="muted">({{localize damageTypeLabel}})</span></div>

   {{#if main}}
   <dl class="breakdown">
      <dt class="head">{{localize "EDRPG.damage.title"}}</dt><dd class="head">{{main.value}}</dd>
      {{#if base}}<dt>{{localize "EDRPG.damage.weapon"}} <span class="muted">{{base.formula}}</span></dt><dd>{{base.total}}</dd>{{/if}}
      {{#if burst}}<dt>{{localize "EDRPG.damage.burst"}} <span class="muted">{{burst.formula}}{{#if burstType}} · {{localize (concat "EDRPG.damage." burstType)}}{{/if}}</span></dt><dd>+{{burst.total}}</dd>{{/if}}
      {{#if strong}}<dt>{{localize "EDRPG.damage.strengthBonus"}}</dt><dd>+{{strong}}</dd>{{/if}}
      {{#if divided}}<dt>{{localize "EDRPG.damage.divided"}}</dt><dd>½</dd>{{/if}}
   </dl>
   {{else}}
   <dl class="breakdown">
      {{#each amounts as |a|}}<dt>{{a.label}}</dt><dd class="big">{{a.value}}</dd>{{/each}}
   </dl>
   {{/if}}
   {{#if dice.length}}<div class="damage-dice">{{#each dice as |d|}}<span class="die {{#if (eq d 10)}}ten{{/if}}">{{d}}</span>{{/each}}</div>{{/if}}
   {{#if jumped}}<div class="attack-note"><i class="fa-solid fa-person-falling-burst"></i> {{localize "EDRPG.reaction.jumpedNote" name=jumped.name}}</div>{{/if}}
   {{#if thrownBack}}<div class="attack-note"><i class="fa-solid fa-baseball"></i> {{localize "EDRPG.reaction.thrownNote"}}</div>{{/if}}
   {{#if explosive}}<div class="attack-note">{{localize "EDRPG.damage.explosiveKnock"}}</div>
   {{else if knock}}<div class="attack-note knock"><i class="fa-solid fa-person-falling"></i> {{localize "EDRPG.damage.knock"}}{{#if free}} {{localize "EDRPG.damage.freeKnock"}}{{/if}}</div>{{/if}}
   {{#if disarm}}<div class="attack-note knock"><i class="fa-solid fa-hand"></i> {{localize "EDRPG.damage.disarm"}}</div>{{/if}}
   {{#if molten}}<div class="attack-note"><i class="fa-solid fa-fire"></i> {{localize "EDRPG.damage.molten" dice=molten}}</div>{{/if}}
   {{#if special.destroysArmour}}<div class="attack-note muted">{{localize "EDRPG.damage.destroysArmourNote"}}</div>{{/if}}
   {{#if special.ignoresArmour}}<div class="attack-note muted">{{localize "EDRPG.damage.ignoresArmourNote" type=(localize (concat "EDRPG.damage." special.ignoresArmour))}}</div>{{/if}}
   {{#if noKnockEnergy}}<div class="attack-note muted">{{localize "EDRPG.damage.noKnockEnergy"}}</div>{{/if}}

   {{#if applied.length}}
   <ul class="damage-applied">
      {{#each applied as |a|}}
      {{#if a.craft}}
      <li>
         <div><strong>{{a.name}}</strong>: {{localize "EDRPG.combined.craftTook" amount=a.amount factor=a.factor scaled=a.scaled}}</div>
         <div>{{#if a.toShields}}{{localize "EDRPG.vehicle.shieldsHit" before=a.shieldsBefore after=a.shieldsAfter}}{{#if a.collapsed}} <span class="ed-chip">{{localize "EDRPG.vehicle.shieldsCollapse"}}</span>{{/if}}{{/if}}
            {{#if a.toHull}} {{localize "EDRPG.vehicle.hullHit" damage=a.toHull before=a.hullBefore after=a.hullAfter}}{{/if}}
            {{#if a.destroyed}} <span class="ed-chip">{{localize "EDRPG.vehicle.destroyed"}}</span>{{/if}}</div>
         {{#if a.crit}}<div class="ed-crit">{{#if a.crit.nothing}}{{localize "EDRPG.crit.nothing" roll=a.crit.table kind=a.crit.kindLabel}}{{else}}{{localize "EDRPG.crit.result" roll=a.crit.table kind=a.crit.kindLabel name=a.crit.name before=a.crit.before after=a.crit.after}}{{#if a.crit.destroyed}} <span class="ed-chip">{{localize "EDRPG.crit.destroyed"}}</span> {{a.crit.effect}}{{/if}}{{/if}}</div>{{/if}}
      </li>
      {{else}}
      <li class="{{#if a.escaped}}escaped{{/if}}">
         <div><strong>{{a.name}}</strong>: {{localize "EDRPG.damage.took" taken=a.taken}}
            {{#if a.parts}}<span class="muted">({{#each a.parts as |p|}}{{#unless @first}}; {{/unless}}{{localize p.typeLabel}} {{p.value}}{{#if p.armour}} − {{p.absorbed}} {{p.armour.name}}{{#if p.hardened.doubled}} {{localize "EDRPG.damage.doubled"}}{{/if}}{{/if}} → {{p.taken}}{{/each}}{{#if a.hardened}}, {{localize "EDRPG.damage.hardenedRoll" roll=a.hardened.roll target=a.hardened.target}}{{/if}})</span>
            {{else}}<span class="muted">({{a.amount}}{{#if a.shield}} − {{a.shield.absorbed}} {{a.shield.name}}{{/if}}{{#if a.armour}} − {{a.absorbed}} {{a.armour.name}}{{#if a.hardened}}, {{localize "EDRPG.damage.hardenedRoll" roll=a.hardened.roll target=a.hardened.target}}{{#if a.hardened.doubled}} {{localize "EDRPG.damage.doubled"}}{{/if}}{{/if}}{{/if}})</span>{{/if}}
         </div>
         {{#if a.doubled}}<div class="muted">{{localize "EDRPG.damage.doubleRobot"}}</div>{{/if}}
         {{#if a.immune}}<div class="muted">{{localize "EDRPG.damage.mechanical"}}</div>{{/if}}
         {{#if a.shield}}<div class="muted"><i class="fa-solid fa-shield-halved"></i> {{localize "EDRPG.shield.hit" name=a.shield.name before=a.shield.before after=a.shield.after}}{{#if a.shield.collapsed}} {{localize "EDRPG.shield.collapsed"}}{{/if}}</div>{{/if}}
         {{#if a.armourDestroyed.length}}<div class="ed-vengeful"><i class="fa-solid fa-heart-crack"></i> {{localize "EDRPG.damage.armourDestroyed" items=a.armourDestroyedText}}</div>{{/if}}
         {{#if a.molten}}<div class="muted"><i class="fa-solid fa-fire"></i> {{localize "EDRPG.damage.moltenApplied" dice=a.molten}}</div>{{/if}}
         <div>{{#if a.escaped}}{{localize "EDRPG.damage.enduranceBack" value=a.before max=a.max}}{{else}}{{localize "EDRPG.damage.enduranceFromTo" before=a.before after=a.after max=a.max}}{{/if}}
            {{#each a.flags as |f|}}<span class="ed-chip">{{localize f}}</span>{{/each}}
         </div>
         {{#if a.stimText}}<div class="muted"><i class="fa-solid fa-syringe"></i> {{{a.stimText}}}</div>{{/if}}
         {{#if (and a.vengeful (not a.escaped))}}<div class="ed-vengeful"><i class="fa-solid fa-hand-fist"></i> {{localize "EDRPG.damage.vengeful" name=a.name attacker=a.vengeful}}</div>{{/if}}
      </li>
      {{/if}}
      {{/each}}
   </ul>
   {{/if}}
   <div class="damage-controls"></div>
</div>
