<div class="edrpg edrpg-chat karma-use">
   <div class="outcome karma"><i class="fa-solid fa-yin-yang"></i> {{name}}</div>
   <div class="karma-meta">{{localize role}} · {{localize category}}</div>
   <dl class="breakdown">
      <dt>{{localize "EDRPG.karma.spent"}}</dt><dd>{{cost}}</dd>
      <dt>{{localize "EDRPG.karma.remaining"}}</dt><dd>{{remaining}} / {{max}}</dd>
   </dl>
   <div class="karma-effect">{{{description}}}</div>
</div>
