<div class="edrpg edrpg-chat skill-check {{outcome}}">
   {{#if karmaReroll}}<div class="reroll-tag"><i class="fa-solid fa-yin-yang"></i> {{localize "EDRPG.chat.KarmaReroll"}}</div>{{/if}}
   {{#if d100}}
   <dl class="breakdown">
      <dt>{{localize "EDRPG.d100.roll"}}</dt><dd>{{natural}}</dd>
      <dt>{{localize "EDRPG.d100.skillScore"}}</dt><dd>{{d100.score}}</dd>
      {{#if socialFactor}}<dt>{{localize "EDRPG.chat.SocialFactor"}}</dt><dd>+{{socialFactor}}</dd>{{/if}}
      {{#each equipment as |e|}}<dt>{{e.label}}</dt><dd>{{e.value}}</dd>{{/each}}
      {{#if modifier}}<dt>{{localize "EDRPG.d100.modifier"}}</dt><dd>{{modifier}}</dd>{{/if}}
      <dt>{{#if d100.band}}{{localize (concat "EDRPG.d100.band." d100.band)}}{{else}}{{localize "EDRPG.d100.difficulty"}} {{difficulty}}{{/if}}</dt><dd>{{d100.difficulty}}</dd>
      <dt class="head">{{localize "EDRPG.d100.target"}}</dt><dd class="head">{{d100.target}}</dd>
   </dl>
   {{else}}
   <dl class="breakdown">
      <dt>{{localize "EDRPG.chat.Roll"}}</dt><dd>{{natural}}</dd>
      <dt>{{localize "EDRPG.chat.SkillBonus"}}</dt><dd>{{skillBonus}}</dd>
      {{#if socialFactor}}<dt>{{localize "EDRPG.chat.SocialFactor"}}</dt><dd>{{socialFactor}}</dd>{{/if}}
      {{#each equipment as |e|}}<dt>{{e.label}}</dt><dd>{{e.value}}</dd>{{/each}}
      {{#if modifier}}<dt>{{localize "EDRPG.chat.BonusModifier"}}</dt><dd>{{modifier}}</dd>{{/if}}
      <dt>{{localize "EDRPG.chat.DifficultyNumber"}}</dt><dd>{{difficulty}}</dd>
   </dl>
   {{/if}}
   {{{rollHTML}}}
   <div class="outcome {{#if success}}success{{else}}failure{{/if}}">{{localize outcomeLabel}}{{#if d100}}{{#if success}} — {{localize "EDRPG.d100.slShort" sl=d100.sl}}{{/if}}{{/if}}</div>
   {{#if d100.auto}}<div class="attack-note">{{localize (concat "EDRPG.contest.reason." d100.auto)}}</div>{{/if}}
   {{#if canReroll}}
   <button type="button" data-edrpg-action="karmaReroll">
      <i class="fa-solid fa-yin-yang"></i> {{localize "EDRPG.chat.ReRollUsingKarmaTitle"}}
   </button>
   {{/if}}
</div>
