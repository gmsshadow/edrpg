<section class="item-details">
   {{#if isEquipment}}{{> edrpgEquipmentDetails}}{{/if}}
   {{#if isBackground}}
   <div class="form-group">
      <label>{{localize "EDRPG.item.choices"}}</label>
      <div class="form-fields">
         <select name="system.choices" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions backgroundChoices selected=source.choices}}
         </select>
      </div>
      <p class="hint">{{localize "EDRPG.item.choicesHint"}}</p>
   </div>

   <h2 class="section-title">
      <span>{{localize "EDRPG.item.skillBonuses"}}</span>
      {{#if editable}}
      <a class="item-control" data-action="addSkillBonus" data-tooltip="EDRPG.item.addSkillBonus"><i class="fa-solid fa-plus"></i></a>
      {{/if}}
   </h2>
   <ol class="skill-bonus-list">
      {{#each source.skills as |mod idx|}}
      <li data-index="{{idx}}">
         <select name="system.skills.{{idx}}.skill" {{#unless @root.editable}}disabled{{/unless}}>
            {{selectOptions @root.skillChoices selected=mod.skill blank="" localize=true sort=true}}
         </select>
         <input type="number" name="system.skills.{{idx}}.bonus" value="{{mod.bonus}}" step="1" {{#unless @root.editable}}disabled{{/unless}}>
         {{#if @root.editable}}
         <a class="item-control" data-action="removeSkillBonus" data-tooltip="EDRPG.item.removeSkillBonus"><i class="fa-solid fa-trash"></i></a>
         {{/if}}
      </li>
      {{/each}}
   </ol>
   {{/if}}

   {{#if isKarma}}
   <div class="form-group">
      <label>{{localize "EDRPG.item.role"}}</label>
      <div class="form-fields">
         <select name="system.role" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions karmaRoles selected=source.role localize=true}}
         </select>
      </div>
   </div>
   <div class="form-group">
      <label>{{localize "EDRPG.item.category"}}</label>
      <div class="form-fields">
         <select name="system.category" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions karmaCategories selected=source.category localize=true}}
         </select>
      </div>
   </div>
   <div class="form-group">
      <label>{{localize "EDRPG.item.cost"}}</label>
      <div class="form-fields">
         <input type="number" name="system.cost" value="{{source.cost}}" min="0" step="1" {{#if source.costAll}}disabled{{/if}} {{#unless editable}}disabled{{/unless}}>
      </div>
   </div>
   <div class="form-group">
      <label>{{localize "EDRPG.item.costAll"}}</label>
      <div class="form-fields">
         <input type="checkbox" name="system.costAll" {{checked source.costAll}} {{#unless editable}}disabled{{/unless}}>
      </div>
      <p class="hint">{{localize "EDRPG.item.costAllHint"}}</p>
   </div>
   <div class="form-group">
      <label>{{localize "EDRPG.item.attackBonus"}}</label>
      <div class="form-fields">
         <input type="number" name="system.attackBonus" value="{{source.attackBonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
         <select name="system.attackApplies" {{#unless editable}}disabled{{/unless}}>{{selectOptions karmaAttackKinds selected=source.attackApplies blank="" localize=true}}</select>
      </div>
   </div>
   <div class="form-group">
      <label>{{localize "EDRPG.item.defenceBonus"}}</label>
      <div class="form-fields">
         <input type="number" name="system.defenceBonus" value="{{source.defenceBonus}}" step="1" {{#unless editable}}disabled{{/unless}}>
         <select name="system.defenceApplies" {{#unless editable}}disabled{{/unless}}>{{selectOptions karmaDefenceKinds selected=source.defenceApplies blank="" localize=true}}</select>
      </div>
      <p class="hint">{{localize "EDRPG.item.boostHint"}}</p>
   </div>
   <div class="form-group">
      <label>{{localize "EDRPG.item.preventsKnockdown"}}</label>
      <div class="form-fields"><input type="checkbox" name="system.preventsKnockdown" {{checked source.preventsKnockdown}} {{#unless editable}}disabled{{/unless}}></div>
   </div>
   {{#if onOpponent}}
   <div class="form-group">
      <label>{{localize "EDRPG.item.usesPerBattle"}}</label>
      <div class="form-fields">
         <input type="number" name="system.usesPerBattle" value="{{source.usesPerBattle}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}>
         <span>{{localize "EDRPG.item.timesUsed"}}</span>
         <input type="number" name="system.timesUsed" value="{{source.timesUsed}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}>
      </div>
   </div>
   {{/if}}
   {{#if onActor}}
   <div class="form-group">
      <label>{{localize "EDRPG.karma.usedThisTurnLabel"}}</label>
      <div class="form-fields">
         <input type="checkbox" name="system.usedThisTurn" {{checked source.usedThisTurn}} {{#unless editable}}disabled{{/unless}}>
      </div>
   </div>
   {{/if}}
   {{/if}}

   {{#if (or isBackground isKarma)}}
   <div class="form-group">
      <label>{{localize "EDRPG.item.free"}}</label>
      <div class="form-fields">
         <input type="checkbox" name="system.free" {{checked source.free}} {{#unless editable}}disabled{{/unless}}>
      </div>
      <p class="hint">{{localize "EDRPG.item.freeHint"}}</p>
   </div>
   {{/if}}
</section>
