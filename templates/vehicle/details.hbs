<div class="tab vehicle-details {{tab.cssClass}}" data-group="primary" data-tab="details">
   <div class="ed-vspecs">
      <div class="form-group"><label>{{localize "EDRPG.vehicle.category"}}</label><div class="form-fields"><select name="system.category">{{selectOptions craftSizes selected=source.category localize=true}}</select></div></div>
      <div class="form-group"><label>{{localize "EDRPG.vehicle.manufacturer"}}</label><div class="form-fields"><input type="text" name="system.manufacturer" value="{{source.manufacturer}}"></div></div>
      <div class="form-group"><label>{{localize "EDRPG.vehicle.dimensions"}}</label><div class="form-fields"><input type="text" name="system.dimensions" value="{{source.dimensions}}"></div></div>
      <div class="form-group"><label>{{localize "EDRPG.vehicle.bays"}}</label><div class="form-fields"><input type="number" name="system.bays" value="{{source.bays}}" min="0" step="1"></div></div>
      <div class="form-group"><label>{{localize "EDRPG.vehicle.crew"}}</label><div class="form-fields"><input type="number" name="system.crewSize" value="{{source.crewSize}}" min="0" step="1"></div></div>
      <div class="form-group"><label>{{localize "EDRPG.vehicle.passengers"}}</label><div class="form-fields"><input type="number" name="system.passengers" value="{{source.passengers}}" min="0" step="1"></div></div>
      <div class="form-group"><label>{{localize "EDRPG.vehicle.sensors"}}</label><div class="form-fields"><input type="text" name="system.sensors" value="{{source.sensors}}"></div></div>
      <div class="form-group"><label>{{localize "EDRPG.vehicle.cargo"}}</label><div class="form-fields"><input type="text" name="system.cargo" value="{{source.cargo}}"></div></div>
      <div class="form-group"><label>{{localize "EDRPG.item.price"}}</label><div class="form-fields"><input type="text" name="system.cost" value="{{source.cost}}"></div></div>
      <div class="form-group wide"><label>{{localize "EDRPG.vehicle.specialRules"}}</label><div class="form-fields"><input type="text" name="system.special" value="{{source.special}}"></div></div>
   </div>

   <h3 class="ed-vsub">{{localize "EDRPG.vehicle.speedTable"}}</h3>
   <table class="ed-vspeededit">
      <tr><th>{{localize "EDRPG.vehicle.speed"}}</th>{{#each speedRows as |r|}}<th>{{r.speed}}</th>{{/each}}</tr>
      <tr><th>{{localize "EDRPG.vehicle.defenceBonus"}}</th>{{#each speedRows as |r|}}<td><input type="number" name="system.speedTable.{{r.index}}.defence" value="{{r.defence}}" step="1"></td>{{/each}}</tr>
      <tr><th>{{localize "EDRPG.vehicle.attackPenalty"}}</th>{{#each speedRows as |r|}}<td><input type="number" name="system.speedTable.{{r.index}}.attack" value="{{r.attack}}" step="1"></td>{{/each}}</tr>
   </table>

   <h3 class="ed-vsub">{{localize "EDRPG.sheet.notes"}}</h3>
   {{formInput descriptionField value=source.description enriched=enrichedDescription toggled=true name="system.description"}}
</div>
