<header class="ed-vheader">
   <div class="ed-vident">
      <img class="ed-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
      <div class="ed-datasheet-tag">
         <span class="big">{{#if isShip}}{{localize "EDRPG.ship.tag"}}{{else}}{{localize "EDRPG.vehicle.tag"}}{{/if}}</span>
         <span class="small">{{localize "EDRPG.sheet.dataSheet"}}</span>
      </div>
   </div>
   <div class="ed-vtitle">
      <label class="ed-vfield model">
         <span class="ed-tag">{{#if source.model}}{{localize "EDRPG.fleet.name"}}{{else}}{{localize "EDRPG.vehicle.model"}}{{/if}}</span>
         <input type="text" name="name" value="{{actor.name}}">
         {{#if modelLabel}}<span class="ed-vmodel muted">{{modelLabel}}</span>{{/if}}
      </label>
      {{#unless npcShip}}{{#unless system.drone.enabled}}
      <div class="ed-vfield owner" data-tooltip="EDRPG.fleet.ownerHint">
         <span class="ed-tag">{{localize "EDRPG.fleet.owner"}}</span>
         {{#if craftOwner}}
         <a class="ed-vpilot" data-action="openActor" data-uuid="{{craftOwner.uuid}}"><img src="{{craftOwner.img}}" alt=""> {{craftOwner.name}}</a>
         {{#if editable}}<a class="ed-vclear" data-action="clearOwner" data-tooltip="EDRPG.fleet.release"><i class="fa-solid fa-xmark"></i></a>{{/if}}
         {{else}}
         <select name="system.owner" {{#unless editable}}disabled{{/unless}}>
            <option value="">{{localize "EDRPG.fleet.noOwner"}}</option>
            {{selectOptions ownerChoices sort=true}}
         </select>
         {{/if}}
      </div>
      {{/unless}}{{/unless}}
      <div class="ed-vfield pilot" data-tooltip="EDRPG.vehicle.pilotHint">
         <span class="ed-tag">{{localize "EDRPG.vehicle.pilot"}}</span>
         {{#if npcShip}}
         <span class="ed-vpilot drone"><i class="fa-solid fa-user-secret"></i> {{localize "EDRPG.ship.npcCrew"}}</span>
         {{else if system.drone.enabled}}
         <span class="ed-vpilot drone"><i class="fa-solid fa-robot"></i> {{localize "EDRPG.drone.noCrew"}}</span>
         {{else if pilot}}
         <a class="ed-vpilot" data-action="openActor" data-uuid="{{pilot.uuid}}"><img src="{{pilot.img}}" alt=""> {{pilot.name}}</a>
         {{#if editable}}<a class="ed-vclear" data-action="clearPilot" data-tooltip="EDRPG.vehicle.clearPilot"><i class="fa-solid fa-xmark"></i></a>{{/if}}
         {{else}}
         <select name="system.pilot" {{#unless editable}}disabled{{/unless}}>
            <option value="">{{#if pilotMissing}}{{localize "EDRPG.vehicle.pilotMissing"}}{{else}}{{localize "EDRPG.vehicle.noPilot"}}{{/if}}</option>
            {{selectOptions pilotChoices sort=true}}
         </select>
         {{/if}}
      </div>
      <div class="ed-vhandling">
         <label><span>{{localize "EDRPG.vehicle.agility"}}</span><input type="number" name="system.agility" value="{{source.agility}}" step="1"></label>
         {{#if isShip}}
         <label><span>{{localize "EDRPG.vehicle.speed"}}</span><input type="number" name="system.speed" value="{{source.speed}}" min="0" step="1"></label>
         <label><span>{{localize "EDRPG.ship.landingPad"}}</span><input type="text" name="system.landingPad" value="{{source.landingPad}}"></label>
         {{else}}
         <label><span>{{localize "EDRPG.vehicle.maxSpeed"}}</span><input type="number" name="system.maxSpeed" value="{{source.maxSpeed}}" min="0" max="10" step="1"></label>
         <label><span>{{localize "EDRPG.vehicle.accelerate"}}</span><input type="number" name="system.accelerate" value="{{source.accelerate}}" min="0" step="1"></label>
         <label><span>{{localize "EDRPG.vehicle.decelerate"}}</span><input type="number" name="system.decelerate" value="{{source.decelerate}}" min="0" step="1"></label>
         {{/if}}
      </div>
   </div>
</header>
