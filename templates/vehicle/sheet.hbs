<div class="tab vehicle-sheet {{tab.cssClass}}" data-group="primary" data-tab="sheet">
   <div class="ed-vstats">
      <div class="ed-vchevrons">
         <div class="ed-chevron defence" data-tooltip="{{#if isShip}}EDRPG.ship.defenceHint{{else}}EDRPG.vehicle.defenceHint{{/if}}">
            <span class="over">{{#if npcShip}}{{localize "EDRPG.ship.statBlock"}}{{else if isShip}}{{localize "EDRPG.ship.defenceOver"}}{{else}}{{localize "EDRPG.vehicle.defenceOver"}}{{/if}}</span>
            <span class="label">{{localize "EDRPG.vehicle.defence"}}</span>
            <span class="value">{{stats.defence}}</span>
         </div>
         <div class="ed-chevron initiative">
            <span class="over">{{localize "EDRPG.vehicle.initiativeOver"}}</span>
            <a class="label" data-action="rollInitiative" data-tooltip="EDRPG.sheet.rollInitiative">{{localize "EDRPG.sheet.initiative"}}</a>
            <span class="value">{{stats.initiative}}</span>
         </div>
         <div class="ed-chevron pursuit" data-tooltip="{{#if isShip}}EDRPG.ship.pursuitHint{{else}}EDRPG.vehicle.pursuitHint{{/if}}">
            <span class="over">{{#if npcShip}}{{localize "EDRPG.ship.statBlock"}}{{else if isShip}}{{localize "EDRPG.ship.pursuitOver"}}{{else}}{{localize "EDRPG.vehicle.pursuitOver"}}{{/if}}</span>
            <span class="label">{{localize "EDRPG.vehicle.pursuit"}}</span>
            <span class="value">{{stats.pursuit}}</span>
         </div>
      </div>
      <div class="ed-pool hull">
         <div class="ed-pool-title"><span class="ed-roundel"><i class="fa-solid fa-shield"></i></span><span>{{localize "EDRPG.vehicle.hull"}}</span></div>
         <div class="ed-pool-body">
            <div class="ed-pool-value">
               <input type="number" name="system.hull.value" value="{{source.hull.value}}" step="1">
               <span class="max">/ <input type="number" class="max-input" name="system.hull.max" value="{{source.hull.max}}" min="0" step="1"></span>
            </div>
         </div>
      </div>
      <div class="ed-pool shields {{shieldState}}">
         <div class="ed-pool-title"><span class="ed-roundel"><i class="fa-solid fa-shield-halved"></i></span><span>{{localize "EDRPG.vehicle.shields"}}</span></div>
         <div class="ed-pool-body">
            <div class="ed-pool-value">
               <input type="number" name="system.shields.value" value="{{source.shields.value}}" min="0" step="1">
               <span class="max">/ <input type="number" class="max-input" name="system.shields.max" value="{{source.shields.max}}" min="0" step="1"></span>
            </div>
            <div class="ed-vshield-extra">
               <label>{{localize "EDRPG.vehicle.recharge"}} <input type="number" name="system.shields.recharge" value="{{source.shields.recharge}}" min="0" step="1"></label>
               {{#if system.shields.max}}<label class="down" data-tooltip="EDRPG.vehicle.shieldsDownHint"><input type="checkbox" name="system.shields.down" {{checked source.shields.down}}> {{localize "EDRPG.vehicle.shieldsDown"}}</label>{{/if}}
            </div>
         </div>
      </div>
   </div>

   <div class="ed-vzone">
      <span class="ed-vzone-label">{{localize "EDRPG.vehicle.zone"}}</span>
      {{#each combatZones as |label key|}}
      <a class="ed-vzone-btn {{#if (eq @root.zone key)}}active{{/if}}" {{#unless @root.zoneFromMap}}data-action="setZone"{{/unless}} data-zone="{{key}}">{{localize label}}</a>
      {{/each}}
      {{#if zoneFromMap}}<span class="muted">{{localize "EDRPG.vehicle.zoneFromMap"}}</span>{{/if}}
      <span class="ed-vspeed-now">{{localize "EDRPG.vehicle.speedNow" speed=system.speed}}</span>
   </div>

   <div class="ed-vturn">
      <div class="ed-vturn-head">
         <span class="ed-vturn-title"><i class="fa-solid fa-flag-checkered"></i> {{localize "EDRPG.vcombat.turn"}}</span>
         {{#if speedRange}}<span class="ed-vturn-range" data-tooltip="EDRPG.vcombat.speedRangeHint">{{localize "EDRPG.vcombat.adjustSpeed" min=speedRange.min max=speedRange.max}}</span>
         {{else if speedLocked}}<span class="ed-vturn-range locked" data-tooltip="EDRPG.vcombat.speedLockedHint"><i class="fa-solid fa-lock"></i> {{localize "EDRPG.vcombat.speedLockedShort"}}</span>{{/if}}
         {{#if destroyed}}<span class="ed-chip ed-vstate destroyed" data-tooltip="EDRPG.vdestroy.chipHint">{{localize "EDRPG.vehicle.destroyed"}}</span>{{/if}}
         {{#if strandedNames}}<span class="ed-chip ed-vstate stranded" data-tooltip="EDRPG.vdestroy.strandedHint">{{localize "EDRPG.vdestroy.strandedChip" names=strandedNames}}</span>{{/if}}
         {{#if npcShip}}<span class="ed-chip ed-vstate" data-tooltip="EDRPG.ship.dogfightingHint">{{localize "EDRPG.ship.dogfighting"}} {{stats.dogfight}}</span>{{/if}}
         {{#if system.immobilised}}<span class="ed-chip ed-vstate destroyed">{{localize "EDRPG.ship.immobilisedChip"}}</span>{{/if}}
         {{#if system.combat.faOff}}<span class="ed-chip ed-vstate sniping" data-tooltip="EDRPG.ship.faOffHint">{{localize "EDRPG.vcombat.action.faOff"}}</span>{{/if}}
         {{#if (eq system.combat.outOfControl 1)}}<span class="ed-chip ed-vstate rammed" data-tooltip="EDRPG.ship.outOfControlHint">{{localize "EDRPG.ship.outOfControlChip"}}</span>{{/if}}
         {{#if system.flying}}<span class="ed-chip ed-vstate flying" data-tooltip="EDRPG.drone.flyingHint">{{localize "EDRPG.drone.flying"}}</span>{{/if}}
         {{#each combatChips as |chip|}}<span class="ed-chip ed-vstate {{chip.key}}" data-tooltip="{{chip.hint}}">{{chip.label}}</span>{{/each}}
         {{#if isGM}}
         <span class="ed-vturn-gm">
            <a data-action="startTurn" data-tooltip="EDRPG.vcombat.startTurnHint"><i class="fa-solid fa-play"></i></a>
            <a data-action="checkObstacles" data-tooltip="EDRPG.vcombat.checkObstacles"><i class="fa-solid fa-mountain"></i></a>
            <a data-action="clearCombat" data-tooltip="EDRPG.vcombat.clearHint"><i class="fa-solid fa-eraser"></i></a>
         </span>
         {{/if}}
      </div>
      {{#if (and owner (not destroyed))}}
      <div class="ed-vactions">
         {{#each vactions as |a|}}<button type="button" data-action="vehicleAction" data-vaction="{{a.key}}" class="{{#if a.taken}}taken{{/if}}" data-tooltip="{{a.hint}}"><i class="{{a.icon}}"></i> {{a.label}}</button>{{/each}}
      </div>
      {{/if}}
   </div>

   {{#if hasEquip}}
   <div class="ed-vequip">
      <span class="ed-vturn-title"><i class="fa-solid fa-toolbox"></i> {{localize "EDRPG.equip.title"}}</span>
      {{#if equip.launch}}<button type="button" data-action="equip" data-equip="launch" data-tooltip="EDRPG.hangar.launchHint"><i class="fa-solid fa-jet-fighter-up"></i> {{localize "EDRPG.hangar.launch"}}</button>{{/if}}
      {{#if equip.chaff}}<button type="button" data-action="equip" data-equip="chaff" class="{{#if equip.chaff.active}}taken{{/if}}" data-tooltip="EDRPG.equip.chaffHint"><i class="fa-solid fa-wand-sparkles"></i> {{localize "EDRPG.equip.chaff"}} {{equip.chaff.value}}/{{equip.chaff.max}}</button>{{/if}}
      {{#if equip.mines}}<button type="button" data-action="equip" data-equip="mines" class="{{#if equip.mines.active}}taken{{/if}}" data-tooltip="EDRPG.equip.minesHint"><i class="fa-solid fa-burst"></i> {{localize "EDRPG.equip.mines"}} {{equip.mines.value}}/{{equip.mines.max}}</button>{{/if}}
      {{#if equip.banks}}<button type="button" data-action="equip" data-equip="cellBank" class="{{#if equip.banks.running}}taken{{/if}}" data-tooltip="EDRPG.equip.bankHint"><i class="fa-solid fa-car-battery"></i> {{localize "EDRPG.equip.cellBank"}} ({{equip.banks.uses}}){{#if equip.banks.running}}: {{equip.banks.running}}{{/if}}</button>{{/if}}
      {{#if equip.floating}}<button type="button" data-action="equip" data-equip="floating" data-tooltip="EDRPG.equip.floatingHint"><i class="fa-solid fa-sliders"></i> {{localize "EDRPG.equip.floatingShort" n=equip.floating.n}}{{#if equip.floating.list}}: {{equip.floating.list}}{{/if}}</button>{{/if}}
      {{#if equip.pd}}<span class="ed-chip ed-vstate" data-tooltip="EDRPG.equip.pdHint">{{localize "EDRPG.equip.pd"}} {{equip.pd.value}}/{{equip.pd.max}}</span>{{/if}}
      {{#if equip.ecm}}<span class="ed-chip ed-vstate" data-tooltip="EDRPG.equip.ecmHint">{{localize "EDRPG.equip.ecm"}}</span>{{/if}}
      <span class="ed-chip ed-vstate" data-tooltip="EDRPG.equip.rechargeHint">{{localize "EDRPG.equip.rechargeNow" n=equip.recharge}}</span>
   </div>
   {{/if}}

   {{#if components.length}}
   <div class="ed-vcomponents">
      {{#each components as |c|}}<span class="ed-vcomp {{#if c.broken}}broken{{/if}}" data-tooltip="{{c.kindLabel}}{{#if c.notes}}: {{c.notes}}{{/if}}">{{#if c.name}}{{c.name}}{{else}}{{c.kindLabel}}{{/if}} <b>{{c.strength.value}}/{{c.strength.max}}</b></span>{{/each}}
   </div>
   {{/if}}

   {{#> edrpgSection title="EDRPG.vehicle.weapons" icon="fa-solid fa-crosshairs" addType="craftWeapon"}}
   <table class="ed-table weapons vweapons">
      <thead>
         <tr>
            <th class="name">{{localize "EDRPG.vehicle.weaponName"}}</th>
            <th>{{localize "EDRPG.sheet.toHit"}}</th>
            <th class="damage">{{localize "EDRPG.sheet.damage"}}</th>
            <th class="damage">{{localize "EDRPG.sheet.ammo"}}</th>
            <th class="notes">{{localize "EDRPG.vehicle.special"}}</th>
         </tr>
      </thead>
      <tbody>
         {{#each weapons as |w|}}
         <tr data-item-id="{{w.id}}" class="draggable">
            <th class="name">
               <a data-action="editItem" class="ed-edit" data-tooltip="EDRPG.sheet.editItem"><i class="fa-solid fa-pen"></i></a>
               <a data-action="rollWeapon" data-tooltip="EDRPG.vehicle.fireHint">{{w.name}}</a>
               <span class="ed-vmount">{{w.mount}}</span>
            </th>
            <td>{{#if (gte w.toHit 0)}}+{{/if}}{{w.toHit}}</td>
            <td class="damage">{{w.damage}}</td>
            <td class="damage ammo">{{#if w.usesAmmo}}<input type="number" data-item-field="system.ammo.value" value="{{w.ammo.value}}" min="0" step="1">/{{w.ammo.max}} <a data-action="reloadWeapon" data-tooltip="EDRPG.weapon.reload"><i class="fa-solid fa-rotate"></i></a>{{else}}—{{/if}}</td>
            <td class="notes">
               {{w.special}}
               {{#if w.turret}}
               <div class="ed-vgunner">
                  <span>{{localize "EDRPG.vehicle.gunner"}}</span>
                  <select data-gunner-select {{#unless @root.editable}}disabled{{/unless}}>
                     <option value="">{{localize "EDRPG.vehicle.automatic"}}</option>
                     {{selectOptions @root.pilotChoices selected=w.gunner sort=true}}
                  </select>
               </div>
               {{/if}}
            </td>
         </tr>
         {{else}}<tr class="empty"><td colspan="5">{{localize "EDRPG.vehicle.noWeapons"}}</td></tr>{{/each}}
      </tbody>
   </table>
   {{/edrpgSection}}

   {{#unless isShip}}
   <div class="ed-vspeedtable">
      <div class="ed-vspeed-title"><i class="fa-solid fa-gauge-high"></i> {{localize "EDRPG.vehicle.speedTable"}}</div>
      <table>
         <tr class="speed"><th>{{localize "EDRPG.vehicle.speed"}}</th>{{#each speedCells as |c|}}<td class="{{#if c.current}}current{{/if}} {{#if c.beyond}}beyond{{/if}} {{#if c.locked}}locked{{/if}}">{{#unless c.beyond}}<a data-action="setSpeed" data-speed="{{c.speed}}" data-tooltip="EDRPG.vehicle.setSpeedHint">{{c.speed}}</a>{{else}}{{c.speed}}{{/unless}}</td>{{/each}}</tr>
         <tr class="defence"><th>{{localize "EDRPG.vehicle.defenceBonus"}}</th>{{#each speedCells as |c|}}<td class="{{#if c.current}}current{{/if}} {{#if c.beyond}}beyond{{/if}}">{{c.defence}}</td>{{/each}}</tr>
         <tr class="attack"><th>{{localize "EDRPG.vehicle.attackPenalty"}}</th>{{#each speedCells as |c|}}<td class="{{#if c.current}}current{{/if}} {{#if c.beyond}}beyond{{/if}}">{{c.attack}}</td>{{/each}}</tr>
      </table>
   </div>
   {{/unless}}
</div>
